# Copy to `.env` for local overrides (Compose reads these). Never commit secrets.
# v1 uses stub connectors only — no Confluence/SharePoint/Git/test API tokens required.

# Host port published by docker compose (container always listens on 3847).
PORT=3847

# Persistent JSON ledger inside the container (Compose mounts named volume here).
MIREVOX_DATA_DIR=/data

# Optional: URL for future outbound stage-gate notifications (unused by stubs today).
STAGE_GATE_WEBHOOK_URL=

# Node runtime (set automatically in the image).
NODE_ENV=production
